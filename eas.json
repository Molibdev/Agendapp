{
  "cli": {
    "version": ">=27.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "node": "24.19.0"
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
