{
  "expo": {
    "name": "Agendapp",
    "slug": "agendapp",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7842D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.molibdev.agendapp",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "scheme": ["agendapp", "qgasto"],
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7842D6",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#0d0c13",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0d0c13"
          }
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "timePicker": {
              "numbersSelectorColor": {
                "light": "#7132c3",
                "dark": "#7842d6"
              },
              "headerBackground": {
                "light": "#7132c3",
                "dark": "#7842d6"
              }
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d9ef7a8d-49d9-4544-8a72-f8336338eb35"
      }
    },
    "owner": "molibdev"
  }
}
