{
  "expo": {
    "name": "Agendapp",
    "slug": "agendapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#078292",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.molibdev.agendapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "scheme": [
      "agendapp",
      "qgasto"
    ],
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#078292"
        }
      ],
      "expo-font"
    ]
  }
}
