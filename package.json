  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/finance.test.ts && node --import tsx tests/backup.test.ts && node --import tsx tests/report.test.ts && node --import tsx tests/sync.test.ts && node --import tsx tests/accounts.test.ts && node --import tsx tests/agenda.test.ts && node --import tsx tests/drive.test.ts && node --import tsx tests/account.test.ts && node --import tsx tests/automation.test.ts && node --import tsx tests/driveService.test.ts && node --import tsx tests/insights.test.ts && node --import tsx tests/installments.test.ts && node --import tsx tests/recurringRemoval.test.ts && node --import tsx tests/appLock.test.ts && node --import tsx tests/previewBuild.test.ts",
    "build:web": "expo export --platform web",
    "test:web": "node scripts/smoke-web.mjs && node scripts/smoke-agenda.mjs",
    "test:ssr": "node scripts/check-web-ssr.mjs",
    "start:dev": "expo start --dev-client",
    "build:android:dev": "npx eas-cli@27.2.0 build --platform android --profile development",
    "build:android:preview": "npx eas-cli@27.2.0 build --platform android --profile preview",
    "eas-build-post-install": "node scripts/check-preview-build.mjs",
    "test:accounts:web": "node scripts/smoke-accounts.mjs",
    "check:public-key": "node scripts/check-public-client-key.mjs",
    "test:design:web": "node scripts/smoke-redesign.mjs",
    "test:branding:web": "node scripts/smoke-branding.mjs",
    "test:navigation:web": "node scripts/smoke-navigation.mjs",
    "test:interactions:web": "node scripts/smoke-interactions.mjs",
    "test:installments:web": "node scripts/smoke-installments.mjs",
    "test:preferences:web": "node scripts/smoke-preferences.mjs",
    "test:report:web": "node scripts/smoke-report.mjs",
    "generate:demo": "node --import tsx scripts/generate-demo-data.ts --excel"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
